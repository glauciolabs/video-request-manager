# Shared
JWT_SECRET=change-me
SERVICE_JWT_SECRET=change-me-too

# Gateway
GATEWAY_PORT=8080
AUTH_MODE=none
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3006
ORDER_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3003
SLA_SERVICE_URL=http://localhost:3004
REPORT_SERVICE_URL=http://localhost:3005
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_ADMIN_ROLE=
TRACKING_BASE_URL=http://localhost:3000/tracking
BUSINESS_TIMEZONE=America/Sao_Paulo

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
NEXT_PUBLIC_ENABLE_MSAL=false
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=

# PostgreSQL (default)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=video_request_manager
POSTGRES_USER=video_request
POSTGRES_PASSWORD=video_request

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DEFAULT_CHAT_ID=your-admin-chat-id
TELEGRAM_TIMEOUT_MS=12000
TELEGRAM_MAX_RETRIES=2

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=mailer@your-domain.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM="Video Request Manager <mailer@your-domain.com>"
SMTP_FROM_NAME="Video Request Manager"
SMTP_FROM_EMAIL=mailer@your-domain.com
SMTP_REPLY_TO=suporte@your-domain.com
SMTP_ENVELOPE_FROM=mailer@your-domain.com

# Deliverability:
# - Configure SPF, DKIM and DMARC for your sending domain.
# - Keep SMTP_FROM/SMTP_FROM_EMAIL aligned with SMTP_USER domain.
