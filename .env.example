# -----------------------------------------------------------------------------
# Core secrets/shared auth
# -----------------------------------------------------------------------------
JWT_SECRET=change-me
SERVICE_JWT_SECRET=change-me-too
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# Runtime/general behavior
# -----------------------------------------------------------------------------
LOG_LEVEL=info
BUSINESS_TIMEZONE=America/Sao_Paulo
ORDER_DATA_BACKEND=memory
DATA_BACKEND=memory

# -----------------------------------------------------------------------------
# Cloudflare D1 (used when ORDER_DATA_BACKEND=d1)
# -----------------------------------------------------------------------------
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=
D1_API_BASE_URL=https://api.cloudflare.com/client/v4
D1_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# API Gateway
# AUTH_MODE: none | local | entra
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
TRUST_PROXY=true
UPSTREAM_TIMEOUT_MS=30000
AUTH_MODE=none
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3006
ORDER_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3003
SLA_SERVICE_URL=http://localhost:3004
REPORT_SERVICE_URL=http://localhost:3005
FORM_ENTRY_ENABLED=false
FORM_ENTRY_PASSWORD=
FORM_ACCESS_TOKEN_TTL=2h
FORM_ACCESS_RATE_LIMIT_MAX=10
FORM_ACCESS_MAX_ATTEMPTS=5
FORM_ACCESS_BLOCK_MINUTES=15
FORM_ACCESS_JWT_SECRET=

# Entra validation in gateway
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_SCOPE=
ENTRA_ALLOW_ANY_AUDIENCE=true
ENTRA_ADMIN_ROLE=

# -----------------------------------------------------------------------------
# Frontend (client + admin runtime)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR
NEXT_PUBLIC_ENABLE_MSAL=false
NEXT_PUBLIC_AUTH_MODE=none
NEXT_PUBLIC_FORM_ENTRY_ENABLED=false

# Entra config exposed to admin SPA
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_SCOPE=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_SCOPE=

# -----------------------------------------------------------------------------
# Tracking + notifications
# -----------------------------------------------------------------------------
TRACKING_BASE_URL=http://localhost:3000/tracking
PIX_PAYMENT_KEY=
# Optional explicit client exposure (frontend can also read PIX_PAYMENT_KEY at runtime)
NEXT_PUBLIC_PIX_PAYMENT_KEY=
ADMIN_NOTIFICATION_EMAILS=

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_DEFAULT_CHAT_ID=your-admin-chat-id
TELEGRAM_TIMEOUT_MS=12000
TELEGRAM_MAX_RETRIES=2

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=mailer@your-domain.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM="Video Request Manager <mailer@your-domain.com>"
SMTP_FROM_NAME="Video Request Manager"
SMTP_FROM_EMAIL=mailer@your-domain.com
SMTP_REPLY_TO=support@your-domain.com
SMTP_ENVELOPE_FROM=mailer@your-domain.com

# Deliverability:
# - Configure SPF, DKIM and DMARC for your sending domain.
# - Keep SMTP_FROM/SMTP_FROM_EMAIL aligned with SMTP_USER domain.

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (public site key + server secret)
# -----------------------------------------------------------------------------
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_MS=8000
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL (default)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=video_request_manager
POSTGRES_USER=video_request
POSTGRES_PASSWORD=video_request

# -----------------------------------------------------------------------------
# Monthly logical dump to Azure DevOps Git (production CronJob)
# -----------------------------------------------------------------------------
BACKUP_GIT_REPO_URL=
BACKUP_GIT_BRANCH=main
BACKUP_GIT_USERNAME=azure-devops
BACKUP_GIT_PAT=
BACKUP_GIT_AUTHOR_NAME="video-request-manager backup"
BACKUP_GIT_AUTHOR_EMAIL=backup-bot@local
BACKUP_RETENTION_MONTHS=12
